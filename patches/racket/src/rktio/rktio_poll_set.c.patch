+#ifdef __EMSCRIPTEN__
+/* Emscripten's poll()/select() do not block for a timeout (WasmFS, no Asyncify), so the code below returns at once and the Racket scheduler
+   spins at 100% CPU while idle.  An embedder that can wake the runtime when work arrives (qt-shim/wasm: a callback queued by the Qt thread)
+   provides this function; it sleeps up to `secs` seconds and returns early on a wake-up.  Without it the old behaviour is unchanged. */
+extern void rqt_wasm_idle_wait(double secs) __attribute__((weak));
+#endif
+
 void rktio_sleep(rktio_t *rktio, float nsecs, rktio_poll_set_t *fds, rktio_ltps_t *lt)
 {
   if (fds && fdset_has_nosleep(fds))
     return;
 
+#ifdef __EMSCRIPTEN__
+  if (rqt_wasm_idle_wait) {
+    /* nsecs <= 0 means "until an external event"; cap it so the scheduler re-checks at least once a second. */
+    rqt_wasm_idle_wait((nsecs <= 0.0f || nsecs > 1.0f) ? 1.0 : (double)nsecs);
+    return;
+  }
+#endif
+
   if (fds && lt) {
 #if defined(HAVE_KQUEUE_SYSCALL) || defined(HAVE_EPOLL_SYSCALL)
     int fd = rktio_ltps_get_fd(lt);
